{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "城市赛事承办审议领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "APPLICATION_FILED",
        "APPLICATION_WITHDRAWN",
        "SUPPLEMENT_REQUESTED",
        "SUPPLEMENT_PROVIDED",
        "RESOURCE_CONFLICTED",
        "RESOURCE_CONFLICT_RESOLVED",
        "RESOURCE_RESERVED",
        "RESOURCE_RELEASED",
        "RECUSAL_DECLARED",
        "OPINION_SIGNED",
        "DECISION_ISSUED",
        "CONDITION_FULFILLED",
        "CHANGE_REQUESTED",
        "CHANGE_REOPENED",
        "PUBLIC_SERVICE_COMMITTED",
        "PUBLIC_SERVICE_REVOKED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "event_application",
        "resource_commitment",
        "review_opinion",
        "portfolio_decision",
        "public_service_commitment"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "description": "串联同一赛事全部过程事件的关联 id，通常为申办 id，供审计回放使用。"
    },
    "payload": {
      "type": "object",
      "description": "业务内容，按事件类型各自定义。"
    }
  },
  "additionalProperties": true
}
