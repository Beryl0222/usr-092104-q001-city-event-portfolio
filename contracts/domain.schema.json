{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "城市赛事承办审议领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "APPLICATION_FILED",
        "RESOURCE_CONFLICTED",
        "OPINION_SIGNED",
        "DECISION_ISSUED",
        "CHANGE_REOPENED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "event_application",
        "resource_commitment",
        "review_opinion",
        "portfolio_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
